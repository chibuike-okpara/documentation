{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "Modem Pay",
  "analytics": {
    "gtm": {
      "tagId": "GTM-MG9SRBZJ"
    }
  },
  "colors": {
    "primary": "#08a591",
    "light": "#08a591",
    "dark": "#08a591"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "documentation/introduction",
              "documentation/quickstart",
              "documentation/installation",
              "documentation/authentication"
            ]
          },
          {
            "group": "Build and test",
            "pages": [
              "documentation/cli",
              "documentation/test-mode",
              "documentation/errors"
            ]
          },
          {
            "group": "Get paid",
            "pages": [
              "documentation/payments/overview",
              "documentation/core/payment-links",
              "documentation/payments/drop-in",
              "documentation/payments/modem-inline",
              "documentation/payments/html-checkout",
              "documentation/payments/custom"
            ]
          },
          {
            "group": "Payments API",
            "pages": [
              "documentation/payment-intents/overview",
              "documentation/payment-intents/create",
              "documentation/payment-intents/management",
              "documentation/payment-intents/direct-charge",
              "documentation/payment-intents/refund",
              "documentation/payment-intents/callback_url"
            ]
          },
          {
            "group": "Webhooks",
            "pages": ["documentation/core/webhooks"]
          },
          {
            "group": "Pay people",
            "pages": [
              "documentation/payouts/overview",
              "documentation/payouts/mobile-money",
              "documentation/payouts/bulk-payout",
              "documentation/payouts/fees",
              "documentation/payouts/payout-channels",
              "documentation/payouts/reversals"
            ]
          },
          {
            "group": "Balances and reports",
            "pages": [
              "documentation/core/balances",
              "documentation/core/transactions"
            ]
          },
          {
            "group": "Customers and discounts",
            "pages": [
              "documentation/core/customers",
              "documentation/core/mandates",
              "documentation/core/coupons"
            ]
          },
          {
            "group": "Split payments",
            "pages": [
              "documentation/split-payments/overview",
              "documentation/split-payments/sub-accounts",
              "documentation/split-payments/sub-account-groups",
              "documentation/split-payments/initialize-payment"
            ]
          },
          {
            "group": "Accept in person",
            "pages": ["documentation/virtual-terminal"]
          },
          {
            "group": "Stablecoins",
            "pages": [
              "documentation/stablecoins/overview",
              "documentation/stablecoins/accept-payments",
              "documentation/stablecoins/convert-to-dalasi",
              "documentation/stablecoins/price-estimates",
              "documentation/stablecoins/resellers"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.json",
        "groups": [
          {
            "group": "Payments",
            "pages": ["POST /v1/payments"]
          },
          {
            "group": "Payment links",
            "pages": ["POST /v1/payment-links"]
          },
          {
            "group": "Payouts",
            "pages": ["POST /v1/transfers"]
          },
          {
            "group": "Customers",
            "pages": ["POST /v1/customers"]
          },
          {
            "group": "Transactions",
            "pages": ["GET /v1/transactions/{transaction_id}"]
          }
        ]
      },
      {
        "tab": "Invoices",
        "groups": [
          {
            "group": "Invoices",
            "pages": [
              "billing/invoices/introduction",
              "billing/invoices/quickstart",
              "billing/invoices/types",
              "billing/invoices/lifecycle",
              "billing/invoices/api-reference"
            ]
          }
        ]
      },
      {
        "tab": "Plugins and frameworks",
        "groups": [
          {
            "group": "Laravel",
            "pages": [
              "laravel/quickstart",
              "laravel/configuration",
              "laravel/usage",
              "laravel/webhooks"
            ]
          },
          {
            "group": "WordPress",
            "pages": ["plugins/woocommerce", "plugins/payment-form"]
          }
        ]
      }
    ],
    "global": {
      "anchors": []
    }
  },
  "logo": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo.png"
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript",
        "php",
        "go",
        "java",
        "ruby"
      ],
      "defaults": "required",
      "prefill": false
    }
  },
  "navbar": {
    "links": [
      {
        "label": "CLI",
        "href": "https://docs.modempay.com/documentation/cli"
      },
      {
        "label": "Support",
        "href": "mailto:info@modempay.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://merchant.modempay.com"
    }
  },
  "contextual": {
    "options": ["copy", "chatgpt", "claude", "mcp", "cursor"]
  },
  "footer": {
    "socials": {
      "linkedin": "https://linkedin.com/company/modempay"
    }
  },
  "redirects": [
    {
      "source": "/documentation/defi/offramp",
      "destination": "/documentation/stablecoins/convert-to-dalasi"
    },
    {
      "source": "/documentation/defi/offramp-resellers",
      "destination": "/documentation/stablecoins/resellers"
    },
    {
      "source": "/documentation/defi/accept-stablecoin-payments",
      "destination": "/documentation/stablecoins/accept-payments"
    },
    {
      "source": "/documentation/sessions/sessions",
      "destination": "/documentation/payment-intents/create"
    },
    {
      "source": "/documentation/sessions/manage-sessions",
      "destination": "/documentation/payment-intents/management"
    },
    {
      "source": "/documentation/development",
      "destination": "/documentation/quickstart"
    },
    {
      "source": "/integrations/introduction",
      "destination": "/documentation/introduction"
    },
    {
      "source": "/api-reference/introduction",
      "destination": "/documentation/introduction"
    },
    {
      "source": "/api-reference/endpoint/:slug*",
      "destination": "/documentation/introduction"
    },
    {
      "source": "/ai-tools/:slug*",
      "destination": "/documentation/introduction"
    },
    {
      "source": "/payments/overview",
      "destination": "/documentation/payments/overview"
    },
    {
      "source": "/documentation/api-keys",
      "destination": "/documentation/authentication"
    },
    {
      "source": "/documentation/core/webhook-cli",
      "destination": "/documentation/cli"
    }
  ],
  "description": "Accept mobile money and card payments, send payouts, split revenue and settle stablecoins in The Gambia."
}
